/**
 * 小鲸自带键盘 —— 样式自带（所有权矩阵 C：不许碰 app.wxss，token 用 var 继承）。
 *
 * 高度预算（契约：≤ 320rpx）：词模式 = 联想 44 + 行距 8 + 4×(键 50 + 行距 8) + 上下留白 22
 * ≈ 306rpx；letters 模式无联想条 ≈ 254rpx。
 *
 * 视觉红线自查：无渐变；键底阴影是"0 2rpx 0"的硬边结构投影（无 blur，不是发光）；
 * 动效只动 transform（按压缩放）；prefers-reduced-motion 全关。
 */

.kb {
  background: var(--card-2, #F5EFE0);
  border-top: 2rpx solid var(--line, rgba(46, 74, 98, 0.16));
  padding: 8rpx 8rpx 14rpx;
  /* 键盘是"设备面板"不是"卡片"：方角贴边更像系统组件，圆角会显得像弹窗 */
}

/*------------------------- 联想条 -------------------------*/

.kb-sugs {
  display: flex;
  align-items: center;
  height: 44rpx;
  margin-bottom: 8rpx;
  padding: 0 4rpx;
  /* 用 margin 而不是 flex gap：gap 在低版本基础库不生效，候选会挤成一团 */
}

.kb-sug {
  flex-shrink: 0;
  margin-right: 12rpx;
  padding: 0 16rpx;
  line-height: 44rpx;
  font-size: 26rpx;
  color: var(--green-d, #005B41);
  background: var(--card, #FFFDF7);
  border-radius: 22rpx;
  transition: transform var(--dur-tap, 120ms) var(--ease-out, ease-out);
}

/*------------------------- 键面 -------------------------*/

.kb-row {
  display: flex;
  margin-bottom: 8rpx;
}

.kb-row:last-child { margin-bottom: 0; }

.kb-key {
  flex: 1;
  min-width: 0;
  margin: 0 4rpx;
  height: 50rpx;
  line-height: 46rpx;               /* 留 4rpx 给底边硬投影，视觉重心居中 */
  text-align: center;
  font-size: 28rpx;
  color: var(--ink, #2E4A62);
  background: var(--card, #FFFDF7);
  border-radius: var(--r-xs, 8rpx);
  box-shadow: 0 2rpx 0 rgba(46, 74, 98, 0.14);   /* 硬边结构投影：键帽的"厚度"，无 blur */
  transition: transform var(--dur-tap, 120ms) var(--ease-out, ease-out);
}

/* shift 激活态：键帽大写显示。text-transform 只影响显示，值由 JS 决定 */
.kb-caps .kb-key { text-transform: uppercase; }

.kb-fn {
  flex: 0 0 96rpx;
  background: rgba(46, 74, 98, 0.08);   /* 功能键比字母键"沉"一档，扫一眼能分区 */
  font-size: 26rpx;
}

.kb-shift-on {
  background: var(--green, #00825C);
  color: var(--on-accent, #FFFFFF);
}

.kb-space { flex: 1; }

.kb-mic { flex: 0 0 120rpx; }

.kb-off { opacity: 0.45; }            /* 语音不可用：置灰 + 组件内 toast（见 js） */

.kb-go {
  flex: 0 0 140rpx;
  background: var(--green, #00825C);
  color: var(--on-accent, #FFFFFF);
  font-weight: 600;
}

/* 按压反馈：缩放即可，不换背景色 —— 换色会与"硬投影"叠出脏色 */
.kb-press { transform: scale(0.94); }

/* 前庭障碍降级：本组件唯一的动效就是按压缩放，全关 */
@media (prefers-reduced-motion: reduce) {
  .kb-key, .kb-sug { transition: none; }
  .kb-press { transform: none; }
}
