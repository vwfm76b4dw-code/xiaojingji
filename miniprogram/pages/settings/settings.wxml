<view class="page {{themeClass}} page-fade">

  <!-- 学习量 -->
  <view class="card" style="margin-top: 24rpx;">
    <view class="section-label">学习量</view>

    <view class="row" bindtap="toggle" data-k="autoDaily">
      <view class="row-main">
        <text class="row-title">自动学习量（推荐）</text>
        <text class="t-hint">本地看你近 7 天的数据，帮你定今天的新词与复习量 —— 不联网、不连 AI</text>
      </view>
      <view class="switch {{cfg.autoDaily ? 'on' : ''}}"><view class="knob"></view></view>
    </view>

    <view wx:if="{{cfg.autoDaily}}" class="t-hint" style="margin-top: 8rpx; padding: 12rpx 16rpx; background: var(--green-wash); border-radius: var(--r-sm);">
      已启用：数值会随你近 7 天表现微调；下面两个值是「推荐之前的基准」，开关关掉时仍生效。
    </view>

    <view class="row">
      <view class="row-main">
        <text class="row-title">每日新词数</text>
        <text class="t-hint">{{cfg.autoDaily ? '基准值 · 自动模式开启时由本地建议替代' : '每天第一次学的单词数量'}}</text>
      </view>
      <view class="stepper">
        <view class="step-btn" data-k="dailyNewWords" data-d="-5" data-min="5" data-max="50" bindtap="step">−</view>
        <text class="step-val t-num">{{cfg.dailyNewWords}}</text>
        <view class="step-btn" data-k="dailyNewWords" data-d="5" data-min="5" data-max="50" bindtap="step">＋</view>
      </view>
    </view>

    <view class="row">
      <view class="row-main">
        <text class="row-title">每日复习上限</text>
        <text class="t-hint">{{cfg.autoDaily ? '基准值 · 自动模式开启时由本地建议替代' : '词库变大后防止一次涌出太多'}}</text>
      </view>
      <view class="stepper">
        <view class="step-btn" data-k="dailyReviewMax" data-d="-10" data-min="10" data-max="200" bindtap="step">−</view>
        <text class="step-val t-num">{{cfg.dailyReviewMax}}</text>
        <view class="step-btn" data-k="dailyReviewMax" data-d="10" data-min="10" data-max="200" bindtap="step">＋</view>
      </view>
    </view>
  </view>

  <!-- 朗读练习 -->
  <view class="card" style="margin-top: 24rpx;">
    <view class="section-label">朗读练习（AI 听音评测）</view>

    <!--
      词数放在这里而不是「学习量」：它只被朗读页读（pronounce.js 的 cfg.sessionSize），
      复习页根本不看它。放在「学习量」卡片里会让学生以为调完复习量就变了 ——
      一个改了没反应的开关，比没有这个开关更伤信任。
    -->
    <view class="row">
      <view class="row-main">
        <text class="row-title">朗读练习词数</text>
        <text class="t-hint">朗读页一次练多少个词</text>
      </view>
      <view class="stepper">
        <view class="step-btn" data-k="sessionSize" data-d="-5" data-min="5" data-max="50" bindtap="step">−</view>
        <text class="step-val t-num">{{cfg.sessionSize}}</text>
        <view class="step-btn" data-k="sessionSize" data-d="5" data-min="5" data-max="50" bindtap="step">＋</view>
      </view>
    </view>

    <view class="row" bindtap="toggle" data-k="autoPlayAudio">
      <view class="row-main">
        <text class="row-title">没读好时自动播放发音</text>
        <text class="t-hint">读完立刻听标准读音，趁热纠正</text>
      </view>
      <view class="switch {{cfg.autoPlayAudio ? 'on' : ''}}"><view class="knob"></view></view>
    </view>

    <view class="row" bindtap="toggle" data-k="recordUnknown">
      <view class="row-main">
        <text class="row-title">把"不会读"的词收进错题本</text>
        <text class="t-hint">之后能在「错题重练」里专门过一遍</text>
      </view>
      <view class="switch {{cfg.recordUnknown ? 'on' : ''}}"><view class="knob"></view></view>
    </view>

    <!-- 判定尺度 -->
    <view class="row" style="flex-direction: column; align-items: stretch;">
      <view class="row-main" style="margin-bottom: 16rpx;">
        <text class="row-title">判定尺度</text>
        <text class="t-hint">宽松更容易通过；严格会揪出发音细节</text>
      </view>
      <view class="chips">
        <view class="chip {{cfg.passScore <= 0.80 ? 'on' : ''}}" data-level="loose" bindtap="pickThreshold">宽松</view>
        <view class="chip {{cfg.passScore > 0.80 && cfg.passScore < 0.88 ? 'on' : ''}}" data-level="normal" bindtap="pickThreshold">标准</view>
        <view class="chip {{cfg.passScore >= 0.88 ? 'on' : ''}}" data-level="strict" bindtap="pickThreshold">严格</view>
      </view>
      <text class="t-hint" style="margin-top: 12rpx;">
        当前阈值 {{cfg.passScore}}（低于此分提示"再读一次"）
      </text>
    </view>
  </view>

  <!-- 反馈 -->
  <view class="card" style="margin-top: 24rpx;">
    <view class="section-label">反馈与显示</view>

    <view class="row" bindtap="toggle" data-k="showHook">
      <view class="row-main">
        <text class="row-title">显示记忆钩子</text>
        <text class="t-hint">翻卡时展示词根/联想记忆法</text>
      </view>
      <view class="switch {{cfg.showHook ? 'on' : ''}}"><view class="knob"></view></view>
    </view>

    <view class="row" bindtap="toggle" data-k="sfx">
      <view class="row-main">
        <text class="row-title">反馈音效</text>
        <text class="t-hint">答对/答错的提示音（朗读页不响）</text>
      </view>
      <view class="switch {{cfg.sfx ? 'on' : ''}}"><view class="knob"></view></view>
    </view>
  </view>



  <!-- 主题卡：不受家长锁（外观偏好不改学习行为），所以放在折叠组之外。
       原来它夹在第 3、4 张被锁卡中间，为把 6 张收成一个连续分组挪到了这里。 -->
  <!--
    主题（2026-09-25）：5 套清透浅色配色，点选即时生效并持久化。
    为什么独立成卡而不是塞进「反馈与显示」：色卡一行 5 个占宽，混进行式开关里
    会把那两行开关挤成不对称；独立卡片与设置页其余分区同构（section-label + 内容）。
    为什么不过家长锁：外观偏好不改学习行为、不碰数据（见 settings.js pickTheme 注释）。
  -->
  <view class="card" style="margin-top: 24rpx;">
    <view class="section-label">主题</view>
    <view class="theme-grid">
      <view wx:for="{{themes}}" wx:key="id"
            class="theme-swatch {{themeId === item.id ? 'on' : ''}}"
            data-theme="{{item.id}}" bindtap="pickTheme"
            aria-role="button" aria-label="主题 {{item.label}}">
        <view class="sw-dot" style="background: {{item.swatch}};"></view>
        <text class="sw-name">{{item.label}}</text>
      </view>
    </view>
    <view class="t-hint" style="margin-top: 12rpx;">{{themeDesc}}</view>
  </view>

  <view class="foot t-hint">
    小鲸记单词 · 数据只存本机
  </view>

</view>
