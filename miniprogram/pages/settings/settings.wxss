/* 设置项：一行一个，标题+说明在左，控件在右 */
.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 22rpx 0;
  border-bottom: 2rpx solid var(--line);
}
.row:last-child { border-bottom: none; }
.row-main { flex: 1; display: flex; flex-direction: column; gap: 4rpx; }
.row-title { font-size: 30rpx; color: var(--ink); }
.row .t-hint { line-height: 1.5; }

/* 步进器：数值参数用 +/- 比滑块精确，也更好点按 */
.stepper {
  display: flex;
  align-items: center;
  gap: 0;
  border: 2rpx solid var(--line-2);
  border-radius: 8rpx;
  overflow: hidden;
  flex-shrink: 0;
}
.step-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  color: var(--green);
  transition: background-color 120ms linear;
}
.step-btn:active { background: rgba(0, 130, 92, 0.12); }
.step-val {
  min-width: 80rpx;
  text-align: center;
  font-size: 30rpx;
  color: var(--ink);
  border-left: 2rpx solid var(--line-2);
  border-right: 2rpx solid var(--line-2);
  padding: 0 8rpx;
  line-height: 64rpx;
}

/* 开关 */
.switch {
  width: 88rpx;
  height: 48rpx;
  border-radius: 24rpx;
  background: var(--line-2);
  position: relative;
  flex-shrink: 0;
  transition: background-color 200ms linear;
}
.switch.on { background: var(--green); }
.knob {
  position: absolute;
  top: 4rpx;
  left: 4rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #FFFDF7;
  transition: transform 200ms cubic-bezier(0.32, 0.94, 0.60, 1);
}
.switch.on .knob { transform: translateX(40rpx); }

/* 尺度选择 */
.chips { display: flex; gap: 16rpx; }
.chip {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  padding: 16rpx 0;
  border: 2rpx solid var(--line-2);
  border-radius: 8rpx;
  color: var(--ink-2);
  transition: transform 120ms cubic-bezier(0.32, 0.94, 0.60, 1);
}
.chip:active { transform: scale(0.96); }
.chip.on {
  border-color: var(--green);
  color: var(--green);
  background: rgba(0, 130, 92, 0.08);
  font-weight: 600;
}

/* 服务状态条 */
.svc {
  padding: 20rpx 24rpx;
  border-radius: 8rpx;
  font-size: 26rpx;
  margin-bottom: 20rpx;
}
.svc.ok { background: rgba(0, 130, 92, 0.10); color: var(--green-d); }
.svc.bad { background: rgba(217, 95, 59, 0.10); color: var(--red); }

.kv-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 14rpx 0;
}
.svc-url { font-size: 24rpx; color: var(--ink-2); text-align: right; word-break: break-all; }

.input {
  background: var(--paper);
  border: 2rpx solid var(--line-2);
  border-radius: 8rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  width: 100%;
  box-sizing: border-box;
}

.foot { text-align: center; padding: 48rpx 0 32rpx; }
