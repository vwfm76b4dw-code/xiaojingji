/* 本页原来自己重抄了一遍 .page（padding 32rpx + min-height 100vh + border-box）。
   2026-09-19 删除：它与 app.wxss 的全局 .page 逐条相同，唯一的效果是——
   `padding` 简写把全局那条的 `env(safe-area-inset-bottom)` 冲掉了，
   于是"非 tabBar 页在刘海屏上要避开 home indicator"这件事在本页静默失效。
   本页是**没有 tabBar** 的页面，正需要那一项，所以让全局规则生效即可。 */

/* 分段切换：绿色选中态 */
.seg {
  display: flex;
  border: 2rpx solid var(--line);
  border-radius: var(--r-md);
  background: var(--card);
  margin-bottom: 32rpx;
}

.seg-item {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  padding: 20rpx 0;
  color: var(--ink-2);
  /* 14rpx 不归入圆角族：外框 .seg 是 16rpx 且带 2rpx 边框，
     16 - 2 = 14 才能与外框同心；写成 --r-md(16) 会让选中块的圆角顶出外框 */
  border-radius: 14rpx;
}

.seg-item.on {
  background: var(--green);
  /* 与 .btn.primary / .mic-btn 同一支 token：原来这里是裸值 #FAF6EC，
     全站"绿底上的字"共用一个来源，改主色时才不会漏掉某一块 */
  color: var(--on-accent);
  font-weight: 600;
}

.form { border-left: 10rpx solid var(--green); }

.field { margin-bottom: 32rpx; }

.label {
  font-size: 26rpx;
  color: var(--ink-2);
  margin-bottom: 12rpx;
}

/* 字段标签与 AI 小按钮同行 */
.label-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.label-row .label { margin-bottom: 0; }

.mini-btn {
  font-size: 24rpx;
  color: var(--green);
  border: 2rpx solid var(--green);
  border-radius: var(--r-xs);
  padding: 6rpx 18rpx;
  transition: transform var(--dur-tap) var(--ease-out);
}

.mini-btn:active { transform: scale(0.94); }

.mini-btn.busy {
  color: var(--ink-2);
  border-color: var(--line);
}

.input {
  background: var(--paper);
  border: 2rpx solid var(--line);
  border-radius: var(--r-xs);
  padding: 20rpx 24rpx;
  font-size: 30rpx;
}

.textarea {
  width: 100%;
  min-height: 280rpx;
  background: var(--paper);
  border: 2rpx solid var(--line);
  border-radius: var(--r-xs);
  padding: 20rpx 24rpx;
  font-size: 30rpx;
  box-sizing: border-box;
  margin: 8rpx 0 32rpx;
}

.hint {
  font-size: 24rpx;
  color: var(--ink-2);
  text-align: center;
  margin-top: 24rpx;
}

/*----------------------- AI 智能录入 -----------------------*/

/* 解析中：横条从左向右扫出，只动 transform */
.ai-loading { margin-top: 24rpx; }

.ai-bar {
  height: 4rpx;
  background: var(--green);
  transform-origin: left center;
  /* 1100ms 是"扫描"的循环周期（不属于交互反馈族，不动）；缓动换 token 同值 */
  animation: ai-scan 1100ms var(--ease-out) infinite;
}

@keyframes ai-scan {
  0%   { transform: scaleX(0); }
  55%  { transform: scaleX(1); }
  100% { transform: scaleX(1); opacity: 0; }
}

/* 前庭障碍降级：本页原来**一条都没有**（全局那条只关 app.wxss 里自己的动画类）。
   这条扫描是 infinite 循环 —— 循环动画是眩晕风险最高的一类，必须能被关掉。
   （另两处页面级动画已有降级：ask.wxss、pronounce.wxss。） */
@media (prefers-reduced-motion: reduce) {
  .ai-bar { animation: none; }
}

/* 提示条：默认中性，warn 用警示红只在"需要你换个做法"时才出现 */
.ai-note {
  margin-top: 28rpx;
  padding: 24rpx;
  background: var(--paper);
  border: 2rpx solid var(--line);
  border-radius: var(--r-xs);
}

.ai-note.warn { border-left: 8rpx solid var(--red); }

.ai-note-text {
  font-size: 26rpx;
  color: var(--ink-2);
  line-height: 1.6;
}

.ai-note .mini-btn {
  display: inline-block;
  margin-top: 20rpx;
}

.ai-result-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin: 32rpx 0 16rpx;
  font-size: 28rpx;
  color: var(--green-d);
  font-weight: 600;
}

.ai-dup {
  font-size: 24rpx;
  color: var(--ink-2);
  font-weight: 400;
}

.ai-list {
  border: 2rpx solid var(--line);
  border-radius: var(--r-xs);
  overflow: hidden;
}

.ai-item {
  display: flex;
  align-items: center;
  padding: 22rpx 24rpx;
  border-bottom: 2rpx solid var(--line);
  background: var(--card);
}

.ai-item:last-child { border-bottom: none; }

.ai-item-main { flex: 1; min-width: 0; }

.ai-w {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--ink);
  margin-right: 16rpx;
}

.ai-m {
  font-size: 26rpx;
  color: var(--ink-2);
}

.ai-del {
  flex-shrink: 0;
  font-size: 24rpx;
  color: var(--red);
  border: 2rpx solid var(--red);
  border-radius: var(--r-xs);
  padding: 6rpx 16rpx;
  margin-left: 16rpx;
  transition: transform var(--dur-tap) var(--ease-out);
}

.ai-del:active { transform: scale(0.94); }

/*----------------------- 教材词库入口 -----------------------*/

.book-entry {
  margin-top: 32rpx;
  border-left: 10rpx solid var(--yellow);
  transition: transform var(--dur-tap) var(--ease-out);
}

.book-entry:active { transform: scale(0.98); }

.be-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--green-d);
}

.be-sub {
  font-size: 24rpx;
  color: var(--ink-2);
  margin-top: 8rpx;
}

/*----------------------- 小鲸键盘（单词字段） -----------------------*/

/* 显示行复用 .input 的底/边/字号 —— 它是"字段"而非按钮，视觉必须与 meaning 等
   系统输入字段同族，学生不会意识到两行输入用的是两套键盘 */
.kb-field { display: flex; align-items: center; min-height: 88rpx; box-sizing: border-box; }

.kb-field-on { border-color: var(--green); }   /* 展开态与全局 focus 语言一致 */

.kb-val { font-size: 30rpx; color: var(--ink); }

.kb-ph { font-size: 30rpx; color: var(--ink-2); opacity: 0.6; }

/* 识别中：右侧常驻状态字，不用 toast —— toast 会打断"按住说完正等着出词"的流 */
.kb-voice-hint { margin-left: auto; font-size: 24rpx; color: var(--green-d); }

/* 停靠层：遮罩吃掉其余点击（点空白收起，与收系统键盘的直觉一致）；
   z-index 90/91 高于本页所有卡片，低于全局弹层 */
.kb-mask {
  position: fixed;
  left: 0; top: 0; right: 0; bottom: 0;
  z-index: 90;
}

.kb-dock {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  z-index: 91;
  /* 键盘本体无 tabBar 遮挡，但要避开 home indicator（本页注释顶部的同一教训） */
  padding-bottom: env(safe-area-inset-bottom);
}
