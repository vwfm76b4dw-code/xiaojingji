.ask-box { margin-bottom: 4rpx; }

.q-input {
  width: 100%;
  min-height: 130rpx;
  font-size: 32rpx;
  line-height: 1.6;
  color: var(--ink);
  box-sizing: border-box;
  background: transparent;
  padding: 12rpx 0;
}
/* 占位符是"示例问法"，学生要照着它学会怎么问 —— 属承载文字，用 --ink-hint */
.ph { color: var(--ink-hint); }

.ask-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 16rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid var(--line);
}
.ask-foot .btn { flex-shrink: 0; }
.warn-text { color: var(--red); }

/* 等待条（复用朗读页的 .sweep 定义思路） */
.judging { position: relative; overflow: hidden; margin-top: 24rpx; }
.sweep {
  position: absolute;
  top: 0; left: 0; bottom: 0;
  width: 180rpx;
  background: var(--green-tint); /* 2026-09-25 收编：原 0,130,92,0.14 裸值，主题化后跟随主色 */
  animation: sweep-move 1100ms linear infinite;
}
@keyframes sweep-move {
  from { transform: translateX(-180rpx); }
  to   { transform: translateX(760rpx); }
}
@keyframes ans-in {
  from { opacity: 0; transform: translateY(-10rpx); }
  to   { opacity: 1; transform: translateY(0); }
}
/* 220ms 归到 --dur-state：回答卡出现是"状态切换"，不是点击反馈也不是整页入场 */
.ans-card.rise { animation: ans-in var(--dur-state) var(--ease-enter) both; }

.ans-card { margin-top: 24rpx; }
.ans-head { margin-bottom: 12rpx; }
.ans-text {
  font-size: 30rpx;
  line-height: 1.85;
  color: var(--ink);
  white-space: pre-wrap;
  word-break: break-word;
}

.ans-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
  padding-top: 18rpx;
  border-top: 2rpx solid var(--line);
}

/* 来源行：点一下听发音，把"查词"与"学发音"连起来 */
.src-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 22rpx 28rpx;
  margin-bottom: 14rpx;
}
.src-main { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 4rpx; }
.src-word { font-size: 34rpx; font-weight: 600; color: var(--ink); }
.src-meaning { font-size: 26rpx; color: var(--ink-2); }
.src-right { display: flex; align-items: center; gap: 14rpx; flex-shrink: 0; }
.src-play {
  font-size: 24rpx;
  color: var(--green);
  border: 2rpx solid var(--green);
  /* 原来是 6rpx 裸值 —— 全站没有比 --r-xs 更小的 token，而它只是"比 .tag 的 r-sm 更收一点"
     的小按钮，归到 r-xs 保持了这个关系（6→8 的 2rpx 差别肉眼不可辨） */
  border-radius: var(--r-xs);
  padding: 6rpx 16rpx;
}

/**
 * 示例问题是**一份清单**（每条 = 类型标签 + 问法），不是一排标签云。
 *
 * 2026-09-19 改左对齐：原来是 flex-wrap + justify-content: center + 宽度由内容决定，
 * 每条长度不同 → 右边界参差，居中排列还让整份"列表"左右都不齐，扫读时找不到行首。
 * 改成竖排整行、左对齐，与页面其它列表（依据的词、来源行）同一口径。
 */
.samples {
  display: flex;
  flex-direction: column;
  margin-top: 40rpx;
}

@media (prefers-reduced-motion: reduce) {
  .sweep, .ans-card.rise { animation: none; }
}

/* 示例问题：带类型标签
   原来是一排纯文字 chip，学生看不出"原来还能这样问"。
   加上标签（分辨两个词 / 记忆法 / 找一类词…）等于把能力清单摆在眼前。 */
.sample-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 18rpx 20rpx;
  margin-bottom: 12rpx;
  border: 2rpx solid var(--line);
  border-radius: var(--r-md);
  background: var(--card);
  /* 空态容器 .empty 是 text-align: center，会一路继承到行内文字上 ——
     整行左对齐必须在这里显式收回，否则"问法"这半截仍是居中的 */
  text-align: left;
  transition: transform var(--dur-tap) var(--ease-out);
}
.sample-row:active { transform: scale(0.98); }
.sample-tag {
  flex: none;
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: var(--r-sm);
  background: var(--green-wash); /* 2026-09-25 收编：原 0,130,92,0.10 裸值，轻底归 wash */
  color: var(--green-d);
}
.sample-q {
  flex: 1;
  font-size: 27rpx;
  color: var(--ink);
}

/* AI 增强生成中的可见状态（2026-09-19） */
.ai-enhancing { margin-top: 20rpx; }
