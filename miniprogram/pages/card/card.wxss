.main { padding: 36rpx; margin-bottom: 24rpx; }

.head {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 28rpx;
}

.prompt {
  font-size: 44rpx;
  font-weight: 600;
  color: var(--ink);
  line-height: 1.45;
  word-break: break-word;
}

.answer {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--green-d);
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid var(--line);
  word-break: break-word;
}

.detail {
  font-size: 26rpx;
  color: var(--ink-2);
  line-height: 1.75;
  margin-top: 20rpx;
}

.hook {
  margin-top: 28rpx;
  padding: 24rpx;
  background: rgba(246, 196, 69, 0.18);
  border-left: 8rpx solid var(--yellow);
  border-radius: 4rpx;
}
.hook-label {
  font-size: 22rpx;
  color: var(--yellow-ink);
  letter-spacing: 0.08em;
  margin-bottom: 10rpx;
}
.hook-text { font-size: 28rpx; color: var(--ink); line-height: 1.75; }

.src { margin-top: 24rpx; padding-top: 20rpx; border-top: 2rpx solid var(--line); }

.algo { margin-bottom: 24rpx; }
.kv {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 0;
  border-bottom: 2rpx solid var(--line);
}
.kv:last-child { border-bottom: none; }

.hist {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 14rpx 0;
  border-bottom: 2rpx solid var(--line);
}
.hist:last-child { border-bottom: none; }
.hist-date { flex: 1; }

.sibs { display: flex; flex-wrap: wrap; gap: 14rpx; }

.note { margin-bottom: 24rpx; }

/* 危险操作区：与上方按钮拉开距离，避免误触 */
.danger-zone {
  margin-top: 64rpx;
  padding-top: 32rpx;
  border-top: 2rpx solid var(--line);
}
